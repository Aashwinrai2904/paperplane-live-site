# TransLink Open API key — https://developer.translink.ca
# Leave unset to run entirely on the built-in mock data generators.
TRANSLINK_API_KEY=

# Override the GTFS-Realtime base URL (defaults to the official TransLink v3 API).
TRANSLINK_GTFS_RT_URL=https://gtfsapi.translink.ca/v3

# RTDS (Real-Time Data Service) corridor speed endpoint, if you have access.
TRANSLINK_RTDS_URL=

# TSPR (Transit Service Performance Review) ridership dataset endpoint, if you have access.
TRANSLINK_TSPR_URL=

# Anthropic API key for the Generative AI Disruption Summarizer.
# Leave unset to use the built-in rule-based summarizer fallback.
ANTHROPIC_API_KEY=

# Optional live traffic camera provider. Must contain the literal "{id}"
# placeholder, e.g. https://example-cameras.com/feed/{id}.jpg
# Leave unset to show an honest "unavailable" placeholder for the Live
# Cameras overlay instead. Must be NEXT_PUBLIC_-prefixed since it's read
# in the browser.
NEXT_PUBLIC_TRAFFIC_CAMERA_URL_TEMPLATE=
